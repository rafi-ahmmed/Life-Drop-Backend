model BloodRequest {
  id String @id @default(uuid())

  requestorId String
  requestor   User   @relation(fields: [requestorId], references: [id], onDelete: Cascade)

  donorRequests DonorRequest[]

  patientName String
  bloodGroup  BloodGroup
  gender      Gender
  reason      String
  phone       String
  units       Int
  address     String
  district    String
  neededAt    DateTime
  urgency     Boolean            @default(false)
  status      BloodRequestStatus @default(PENDING)
  description String?

  reviewerId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([requestorId, createdAt])
  @@index([status, createdAt])
  @@index([bloodGroup, status])
  @@index([urgency, status])
  @@map("blood_requests")
}
