model BloodRequest {
  id String @id @default(uuid())

  requestorId String 
  requestor   User @relation(fields: [requestorId], references: [id], onDelete: Cascade)

  patientName String
  bloodGroup  BloodGroup
  phone       String
  units       Int
  address     String
  district    String
  neededAt    DateTime
  urgency     Boolean            @default(false)
  status      BloodRequestStatus @default(PENDING)
  description String?

  reviewerId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("blood_requests")
}
