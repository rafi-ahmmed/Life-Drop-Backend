model Payment {
  id String @id @default(uuid())

  trxID      String? @unique //sslcommerz and bkash
  amount     Decimal @db.Decimal(10, 2)
  paymentId  String?  @unique //* bkashPayment id and SSLcomarz val_id
  cardType   String? //sslcommerz
  bankTranId String? //sslcommerz

  paidAt          DateTime      @default(now())
  method          PaymentMethod @default(BKASH)
  status          PaymentStatus @default(UNPAID)
  gatewayResponse Json?

  campaignId String
  campaign   FundCampaign @relation(fields: [campaignId], references: [id])
  userId     String
  donor      User         @relation(fields: [userId], references: [id])

  @@index([userId, paidAt])
  @@index([status, paidAt])
  @@map("payments")
}
