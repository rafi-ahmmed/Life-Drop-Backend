model Payment {
  id String @id @default(uuid())

  amount          Decimal       @db.Decimal(10, 2)
  bkashPaymentId  String        @unique
  trxID           String?       @unique
  paidAt          DateTime      @default(now())
  method          PaymentMethod @default(BKASH)
  status          PaymentStatus @default(UNPAID)
  gatewayResponse Json?

  campaignId String
  campaign   FundCampaign @relation(fields: [campaignId], references: [id])
  userId     String
  donor      User         @relation(fields: [userId], references: [id])

  @@index([userId, paidAt])
  @@index([status, paidAt])
  @@map("payments")
}
